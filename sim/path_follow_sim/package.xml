<?xml version="1.0"?>
<package format="3">
  <name>path_follow_sim</name>
  <version>0.1.0</version>
  <description>
    通用轻量仿真工具：运动学底盘仿真、路径场景发布、误差指标记录、SDF 模型参数提取。
    与被测算法完全解耦，只通过 ROS 话题交互。
  </description>
  <maintainer email="dev@example.com">path-follow</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- 仅当 cmd_type 为 ackermann / four_wheel_steering 时才会被导入 -->
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>path_follow_mpc</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
