<launch>
  <arg name="config" default="$(find-pkg-share path_follow_mpc)/config/mpc.yaml"/>
  <arg name="namespace" default=""/>
  <node pkg="path_follow_mpc" exec="mpc_node" name="mpc_tracker"
        namespace="$(var namespace)" output="screen">
    <param from="$(var config)"/>
  </node>
</launch>
